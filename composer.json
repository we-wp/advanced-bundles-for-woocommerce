{
    "name": "aimplugins/aim-advanced-bundles",
    "description": "Free fixed bundles for WooCommerce.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpcompatibility/phpcompatibility-wp": "2.1.8",
        "php-stubs/woocommerce-stubs": "11.0.0",
        "php-stubs/wordpress-stubs": "7.0.1",
        "phpstan/phpstan": "2.2.9",
        "phpunit/phpunit": "11.5.56",
        "wp-coding-standards/wpcs": "3.4.1"
    },
    "autoload": {
        "psr-4": {
            "AIMPlugins\\AdvancedBundles\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AIMPlugins\\AdvancedBundles\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": false,
        "lock": true,
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "security-audit": "composer audit --locked --no-interaction",
        "build": "@php tools/build-package.php",
        "check": [
            "composer validate --strict",
            "@security-audit",
            "@lint",
            "@phpcs",
            "@phpstan",
            "@test",
            "@package-check"
        ],
        "lint": "@php tools/lint.php",
        "package-check": "@php tools/package-check.php",
        "phpcs": "phpcs --standard=phpcs.xml.dist",
        "phpstan": "phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=1G",
        "test": "phpunit --configuration=phpunit.xml.dist"
    }
}
